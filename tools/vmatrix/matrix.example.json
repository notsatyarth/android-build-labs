{
  "_comment": "Example matrix for nowinandroid. '@channel' values are resolved by discovery (stable, rc, beta, alpha, milestone, nightly, next, latest). Plain strings are exact versions.",
  "project": "path/to/nowinandroid",
  "mode": "auto",
  "tasks": [["help"], [":app:assembleDemoDebug"]],
  "gradle_args": ["--console=plain", "--warning-mode=all", "--stacktrace"],
  "guard_tasks": ["buildEnvironment", ":app:buildEnvironment"],
  "timeout_sec": 3600,
  "java_home": null,
  "gradle_user_home": null,
  "daemon_cleanup": "stop",
  "cells": [
    {"name": "baseline"},
    {"name": "gradle-next", "axes": {"gradle": "@next"}},
    {"name": "gradle-nightly", "axes": {"gradle": "@nightly"}},
    {"name": "agp-next", "axes": {"agp": "@next"}},
    {"name": "kotlin-next", "axes": {"kotlin": "@next"}},
    {"name": "agp-9.3.1-pinned", "axes": {"agp": "9.3.1"}},
    {"name": "flag-simulate-agp10", "flags": {"android.simulateAgpVersionBehavior": "10.0.0"}},
    {"name": "flag-kotlin-tryNext", "flags": {"kotlin.experimental.tryNext": "true"}},
    {"name": "flag-warning-fail", "gradle_args": ["--warning-mode=fail"]}
  ]
}
