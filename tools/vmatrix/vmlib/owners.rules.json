{
  "_comment": "Ordered rules, first match wins. field: text (message), location, frames (stack lines joined), group (problem group path). owner is a free label. flags: 'i' = ignore case. Edit this file to teach the classifier about your plugins.",
  "default_owner": "Unknown",
  "rules": [
    {"id": "ksp-text", "owner": "KSP", "field": "text", "regex": "com\\.google\\.devtools\\.ksp|\\bKSP\\b|\\bksp[A-Z][A-Za-z]*(Kotlin)?\\b|\\bksp\\."},
    {"id": "agp-text", "owner": "AGP", "field": "text", "regex": "com\\.android\\.|Android Gradle [Pp]lugin|\\bAGP\\b|'android\\.[\\w.]+|\\bandroid\\.(sync|builtInKotlin|newDsl|enable|useAndroidX|defaults)\\b|androidTestImplementation|agp-sync-issues"},
    {"id": "kotlin-compiler-in-sources", "owner": "Project", "field": "text", "regex": "^Kotlin compiler (warning|error)", "also_location": "\\.(kt|java|kts)\\b"},
    {"id": "agp-group", "owner": "AGP", "field": "group", "regex": "agp-sync-issues|Sync Issues"},
    {"id": "kgp-group", "owner": "KGP/Kotlin", "field": "group", "regex": "^(Kotlin|KGP|COMPILER)\\b|kotlin:"},
    {"id": "kgp-text", "owner": "KGP/Kotlin", "field": "text", "regex": "org\\.jetbrains\\.kotlin|Kotlin Gradle [Pp]lugin|\\bKGP\\b|\\bkotlin\\.(experimental|mpp|build|incremental|daemon|compiler|jvm\\.target)|KotlinCompile|kotlin-gradle-plugin|\\bKT-\\d+|Kotlin compiler"},
    {"id": "frames-ksp", "owner": "KSP", "field": "frames", "regex": "\\bat com\\.google\\.devtools\\.ksp\\."},
    {"id": "frames-agp", "owner": "AGP", "field": "frames", "regex": "\\bat com\\.android\\."},
    {"id": "frames-kgp", "owner": "KGP/Kotlin", "field": "frames", "regex": "\\bat org\\.jetbrains\\.kotlin\\."},
    {"id": "frames-other-plugin", "owner": "Other plugin", "field": "frames", "regex": "\\bat (com\\.google\\.(gms|firebase)|dagger\\.|com\\.squareup\\.|io\\.sentry|app\\.cash|com\\.diffplug|androidx\\.baselineprofile|io\\.gitlab\\.arturbosch|com\\.dropbox|org\\.jlleitschuh)"},
    {"id": "frames-project-scripts", "owner": "Project", "field": "frames", "regex": "\\bat (Build_gradle|Settings_gradle|build_[0-9a-z]+|settings_[0-9a-z]+)\\b|\\bat \\w*ConventionPlugin"},
    {"id": "other-plugin-text", "owner": "Other plugin", "field": "text", "regex": "com\\.google\\.(gms|firebase)|\\bdagger\\b|\\bhilt\\b|com\\.squareup|io\\.sentry|app\\.cash|spotless|roborazzi|dependencyguard|dependency-guard|detekt|ktlint|protobuf"},
    {"id": "gradle-text", "owner": "Gradle", "field": "text", "regex": "org\\.gradle\\.|\\bGradle\\b|[Cc]onfiguration cache|Isolated Projects|scheduled to be removed in Gradle|Gradle:Deprecation"},
    {"id": "gradle-frames", "owner": "Gradle", "field": "frames", "regex": "\\bat org\\.gradle\\."},
    {"id": "project-files", "owner": "Project", "field": "any", "regex": "build\\.gradle(\\.kts)?|settings\\.gradle(\\.kts)?|libs\\.versions\\.toml|/src/|AndroidManifest"}
  ]
}
